{
  "name": "dsalgo-local-ai-frontends",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run build:studio && pnpm run build:workbench",
    "build:studio": "cross-env APP_TARGET=studio vite build",
    "build:workbench": "cross-env APP_TARGET=workbench vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "cross-env": "^10.1.0",
    "lucide-svelte": "^0.577.0",
    "svelte": "^5.53.7",
    "svelte-check": "^4.4.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "packageManager": "pnpm@11.9.0"
}
