COMPOSE_PROJECT_NAME=dsalgo-local-ai-setup
OPEN_WEBUI_PORT=3000
AGENT_STUDIO_PORT=3001
AGENT_GATEWAY_PORT=8001
DEVELOPER_WORKBENCH_PORT=3002
OAUTH_BROKER_PORT=3003
OLLAMA_URL=http://host.docker.internal:11434
AGENT_API_KEY=change-me-generated-by-install
AGENT_ALLOW_WRITES=true
AGENT_MAX_STEPS=10
MODEL_REGISTRY_FILE=/config/models.json
TZ=detect-system-timezone-during-install
